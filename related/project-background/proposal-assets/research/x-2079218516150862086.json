com/amplify_video/2079217374062952448/pl/LfwLj3SiRraUQJPB.m3u8?tag=29&v=cfc"},{"bit_rate":10368000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2079217374062952448/vid/avc1/2560x1392/sxNQ5e7-Yflzthp7.mp4?tag=29"},{"bit_rate":832000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2079217374062952448/vid/avc1/662x360/rF-4VvHketdDjQmd.mp4?tag=29"},{"bit_rate":2176000,"content_type":"video/mp4","url":"https://video.twimg.com/amplify_video/2079217374062952448/vid/avc1/1324x720/IxZXhtZbx7bn6A4Q.mp4?tag=29"}]},"media_key":"13_2079217374062952448"},{"id":"QXBpTWVkaWE6DAAFCgABHNrcDQdWIAAKAAIAAAAAWpQ1NgAA","media_id":"2079216126500675584","media_info":{"__typename":"ApiImage","color_info":{"palette":[{"percentage":82.14,"rgb":{"blue":38,"green":38,"red":38}},{"percentage":9.35,"rgb":{"blue":20,"green":47,"red":142}},{"percentage":4.63,"rgb":{"blue":186,"green":196,"red":201}},{"percentage":1.99,"rgb":{"blue":17,"green":34,"red":88}},{"percentage":0.35,"rgb":{"blue":26,"green":59,"red":200}}]},"original_img_height":950,"original_img_url":"https://pbs.twimg.com/media/HNrcDQdWIAATCj4.jpg","original_img_width":1911},"media_key":"3_2079216126500675584"}]},"twitter_card":"tweet","color":null,"provider":"twitter","reposted_by":null}}